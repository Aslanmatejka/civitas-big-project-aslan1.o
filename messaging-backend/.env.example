# Server Configuration
PORT=3001
NODE_ENV=development

# Client Configuration
CLIENT_URL=http://localhost:3002

# JWT Secret (for future authentication)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# File Upload Configuration
MAX_FILE_SIZE=52428800

# IPFS Configuration
# Mode options: 'local' (requires IPFS daemon), 'infura', 'pinata', 'disabled' (fallback)
IPFS_MODE=local
IPFS_HOST=localhost
IPFS_PORT=5001

# Infura IPFS (if using IPFS_MODE=infura)
# Get free account at https://infura.io
INFURA_PROJECT_ID=your_infura_project_id
INFURA_PROJECT_SECRET=your_infura_project_secret

# Pinata IPFS (if using IPFS_MODE=pinata)
# Get free account at https://pinata.cloud
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key

# ── AI / LLM Configuration ────────────────────────────────────────────────────
# Without OPENAI_API_KEY the AI assistant uses a built-in rule engine (no external calls).
# Set OPENAI_API_KEY to enable real LLM responses.

# OpenAI (https://platform.openai.com)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI
# OPENAI_API_KEY=your-azure-key
# OPENAI_BASE_URL=https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
# OPENAI_MODEL=gpt-4o

# Ollama (local, no API key needed — use any non-empty string)
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.2

# LM Studio (local)
# OPENAI_API_KEY=lmstudio
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_MODEL=your-loaded-model
